# --- Invoice Generator API (required) ------------------------------------
# The tool POSTs the invoice payload to this host and streams back the PDF.
INVOICE_GENERATOR_API_URL=INSERT_THE_API_HOST_HERE
INVOICE_GENERATOR_API_KEY=INSERT_YOUR_API_KEY_HERE

# --- Output (required) ----------------------------------------------------
# Replace YOUR_NAME with your name. The number will be replaced with the invoice number in index.js
# Ultimately you can name here whatever you want
FILE_NAME_FORMAT=Invoice_{{number}}_YOUR_NAME.pdf

# Directory the PDF is written to. Created if it does not exist, and a leading
# "~" is expanded, so the same value works on every machine. Leave it unset to
# write into the current working directory instead.
OUTPUT_DIR=~/path/to/your/invoice/archive

# --- Cloud archive (optional) --------------------------------------------
# Only needed when running with --save. Whitelist the machine's public egress
# IP on the cluster first, or the save step will hang and then fail.
MONGODB_URI=INSERT_YOUR_MONGODB_URI_HERE
